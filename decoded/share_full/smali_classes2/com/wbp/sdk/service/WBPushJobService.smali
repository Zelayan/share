.class public Lcom/wbp/sdk/service/WBPushJobService;
.super LME;


# annotations
.annotation build Landroid/annotation/SuppressLint;
    value = {
        "SpecifyJobSchedulerIdRange"
    }
.end annotation


# direct methods
.method public constructor <init>()V
    .locals 0

    invoke-direct {p0}, LME;-><init>()V

    return-void
.end method
